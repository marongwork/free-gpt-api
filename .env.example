# ==========================================
# OpenAI Prism 反代服务环境配置
# ==========================================

# 1. Prism 官方凭证 (必须是 ChatGPT Plus 或 Pro 账号)
# 从 prism.openai.com 登录后按 F12 -> Network 抓取任意请求的 Authorization 请求头或 Cookie
PRISM_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6Im...
PRISM_COOKIE=

# 2. 项目持久化 ID (可选；若留空则服务启动后自动调用接口创建并复用)
DEFAULT_PROJECT_ID=

# 3. 反代防盗刷密钥 (客户端在请求头中传入此 Key，如 Bearer sk-prism-secret-2026)
PROXY_API_KEY=sk-prism-secret-2026

# 4. 默认调用模型 (可选: o1-astra-xhigh / o3-high / gpt-5.2-prism / gpt-4o)
DEFAULT_MODEL=o1-astra-xhigh

# 5. 性能与超时调优 (单位: 毫秒 / 秒)
POLL_INTERVAL_MS=500
HTTP_TIMEOUT_SECONDS=300
